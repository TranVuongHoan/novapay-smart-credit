      <bpmndi:BPMNShape id="R_start_di" bpmnElement="R_start"><dc:Bounds x="200" y="147" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="175" y="188" width="86" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
