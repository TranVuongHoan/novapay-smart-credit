  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Doi soat cuoi ngay" processRef="Process_Recon" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Recon" name="Doi soat cuoi ngay" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Credit Core">
        <bpmn:flowNodeRef>R_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="ERP">
        <bpmn:flowNodeRef>R_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Finance Ops">
        <bpmn:flowNodeRef>R_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="R_start" name="22:00 Dong ngay giao dich">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="R_1" name="Xuat file lo giao dich">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="R_2" name="Nap file, kiem checksum">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="R_3" name="Doi chieu 3 chieu">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="R_gw" name="Chenh lech &lt; 0.01%?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="R_4" name="Tu dong khop va sinh but toan">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="R_5" name="Xu ly case doi soat">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="R_6" name="Dong so ngay">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="R_7" name="Gui bao cao doi soat 06:00">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="R_end" name="Hoan tat doi soat">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="R_start" targetRef="R_1" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="R_1" targetRef="R_2" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="R_2" targetRef="R_3" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="R_3" targetRef="R_gw" />
    <bpmn:sequenceFlow id="Flow_05" name="Trong nguong" sourceRef="R_gw" targetRef="R_4" />
    <bpmn:sequenceFlow id="Flow_06" name="Vuot nguong - chan dong so" sourceRef="R_gw" targetRef="R_5" />
    <bpmn:sequenceFlow id="Flow_07" name="Da xu ly" sourceRef="R_5" targetRef="R_4" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="R_4" targetRef="R_6" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="R_6" targetRef="R_7" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="R_7" targetRef="R_end" />
  </bpmn:process>
